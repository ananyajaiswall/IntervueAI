# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/intervueai
# For MongoDB Atlas, use this format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/intervueai?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Python FastAPI Interview Coach URL
PYTHON_API_URL=http://localhost:8000
